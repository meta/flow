type INTENTIONAL_ANY = $FlowFixMe;
type JSType = 'number' | 'string' | 'array' | 'boolean';
type CBoolean = ?(number | boolean);

type WASMModuleOverrides = Readonly<{
  quit(status: number, toThrow: Error): void,
}>;

// Flow Rust WASM parser exports the same C ABI as Hermes
export type FlowParserWASM = Readonly<{
  HEAP8: Int8Array,
  HEAP16: Int16Array,
  HEAP32: Int32Array,
  HEAPU8: Uint8Array,
  HEAPU16: Uint16Array,
  HEAPU32: Uint32Array,
  HEAPF32: Float32Array,
  HEAPF64: Float64Array,

  _malloc(size: number): number,
  _free(ptr: number): void,

  ccall(
    ident: string,
    returnType: JSType | null,
    argTypes: ReadonlyArray<JSType>,
    args: ReadonlyArray<
      number | string | ReadonlyArray<INTENTIONAL_ANY> | boolean,
    >,
    opts?: Readonly<{
      async?: boolean | void,
    }>,
  ): INTENTIONAL_ANY,
  cwrap: {
    (
      v0: 'hermesParse',
      v1: 'number',
      v2: [
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
        'number',
      ],
    ): (
      v0: number,
      v1: number,
      v2: number,
      v3: number,
      v4: CBoolean,
      v5: CBoolean,
      v6: CBoolean,
      v7: CBoolean,
      v8: CBoolean,
      v9: CBoolean,
      v10: CBoolean,
      v11: CBoolean,
      v12: number,
      v13: CBoolean,
      v14: CBoolean,
      v15: CBoolean,
      v16: CBoolean,
      v17: CBoolean,
      v18: number,
      v19: CBoolean,
    ) => number,
    (
      v0: 'hermesParseResult_free',
      v1: 'void',
      v2: ['number'],
    ): (v: number) => void,
    (
      v0: 'hermesParseResult_getError',
      v1: 'string',
      v2: ['number'],
    ): (v: number) => string,
    (
      v0: 'hermesParseResult_getErrorLine',
      v1: 'number',
      v2: ['number'],
    ): (v: number) => number,
    (
      v0: 'hermesParseResult_getErrorColumn',
      v1: 'number',
      v2: ['number'],
    ): (v: number) => number,
    (
      v0: 'hermesParseResult_getProgramBuffer',
      v1: 'number',
      v2: ['number'],
    ): (v: number) => number,
    (
      v0: 'hermesParseResult_getPositionBuffer',
      v1: 'number',
      v2: ['number'],
    ): (v: number) => number,
    (
      v0: 'hermesParseResult_getPositionBufferSize',
      v1: 'number',
      v2: ['number'],
    ): (v: number) => number,
    (
      v0: 'hermesParseResult_getStringBuffer',
      v1: 'number',
      v2: ['number'],
    ): (v: number) => number,
  },

  stackAlloc(size: number): number,
  stackSave(): number,
  stackRestore(ptr: number): void,
}>;

declare module.exports: (v: WASMModuleOverrides) => FlowParserWASM;
