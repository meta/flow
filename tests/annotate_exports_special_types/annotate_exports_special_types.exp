  funProtoCall: (this: Function, thisArg: any, ...argArray: Array<any>) => any,
  objProto: typeof Object.prototype,
} {
    return {
        objProto,
        funProto,
        funProtoApply,
        funProtoBind,
        funProtoCall,
    }
}

