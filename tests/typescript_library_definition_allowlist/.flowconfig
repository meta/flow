[options]
all=true
builtin_lib=core-only
experimental.typescript_library_definition_support=true
experimental.typescript_library_definition_support.includes=root.d.{ts,mts,cts}
experimental.typescript_library_definition_support.includes=single/*.d.{ts,mts,cts}
experimental.typescript_library_definition_support.includes=recursive/**/*.d.{ts,mts,cts}
